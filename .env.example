# Copy to .env.local and fill in from Firebase console → Project settings → Your apps.
# These values are not secrets (they ship in the client bundle), but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The only Google account allowed to use the app (must match firestore.rules).
VITE_ALLOWED_EMAIL=

# Dev only: talk to local Firebase emulators instead of the real project.
# VITE_USE_EMULATORS=true
